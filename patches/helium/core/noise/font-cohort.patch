+++ src/third_party/blink/renderer/core/helium_noise/font_cohort.cc
@@ -0,0 +1,258 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+// -----------------------------------------------------------------------
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/helium_noise/font_cohort.h"
+
+#include <cstring>
+
+#include "base/no_destructor.h"
+#include "base/feature_list.h"
+#include "third_party/blink/public/common/features.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/helium_noise/helium_noise_hash.h"
+#include "third_party/blink/renderer/core/helium_noise/helium_noise_profile.h"
+
+namespace blink {
+namespace helium_noise {
+
+namespace {
+
+// Fixed approved table. Row order and aliases are part of the policy
+// contract; aliases never add a row.
+constexpr FontIdentity kApprovedFontIdentities[] = {
+    {"Liberation Sans", {"Arial", ""}, FontGenericClass::kSans},
+    {"Liberation Serif", {"Times New Roman", ""}, FontGenericClass::kSerif},
+    {"Liberation Mono", {"Courier New", ""}, FontGenericClass::kMonospace},
+    {"DejaVu Sans", {"", ""}, FontGenericClass::kSans},
+    {"DejaVu Serif", {"", ""}, FontGenericClass::kSerif},
+    {"DejaVu Sans Mono", {"DejaVu Mono", ""}, FontGenericClass::kMonospace},
+    {"Noto Sans", {"Noto Sans UI", ""}, FontGenericClass::kSans},
+    {"Noto Serif", {"", ""}, FontGenericClass::kSerif},
+    {"Noto Sans Mono", {"Noto Mono", ""}, FontGenericClass::kMonospace},
+};
+
+// Process-local availability probe. Null by default; the platform adapter
+// (Linux only, Task 6) installs a real probe at startup. The test seam swaps
+// it within a scoped guard.
+ScopedFontCohortAvailabilityForTesting::Probe& AvailabilityProbe() {
+  static base::NoDestructor<ScopedFontCohortAvailabilityForTesting::Probe>
+      probe;
+  return *probe;
+}
+
+bool EqualIgnoringAsciiCase(const char* a, const String& b) {
+  if (!a) {
+    return false;
+  }
+  const size_t a_length = strlen(a);
+  if (a_length != b.length()) {
+    return false;
+  }
+  for (size_t i = 0; i < a_length; ++i) {
+    char left = a[i];
+    if (left >= 'A' && left <= 'Z') {
+      left += 'a' - 'A';
+    }
+    UChar right = b[i];
+    if (right >= 'A' && right <= 'Z') {
+      right += 'a' - 'A';
+    }
+    if (static_cast<UChar>(left) != right) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsSortedUniqueAndInRange(base::span<const uint8_t> available,
+                              size_t row_count) {
+  if (available.empty()) {
+    return false;
+  }
+  uint8_t previous = 0;
+  for (size_t i = 0; i < available.size(); ++i) {
+    const uint8_t index = available[i];
+    if (index >= row_count) {
+      return false;
+    }
+    if (i > 0 && index <= previous) {
+      return false;
+    }
+    previous = index;
+  }
+  return true;
+}
+
+// Deterministic rotation among candidates: a fresh hash per choice keeps
+// selections independent per class and per stage.
+size_t HashChoice(uint64_t profile_hash, uint64_t stage_tag, size_t count) {
+  HeliumNoiseHash hash{HeliumNoiseToken(profile_hash)};
+  hash.Update(stage_tag);
+  return hash.GetValueBelow(static_cast<int>(count));
+}
+
+void SelectOneAvailableClass(uint64_t profile_hash,
+                             FontGenericClass generic_class,
+                             base::span<const uint8_t> available,
+                             Vector<uint8_t>& selected) {
+  Vector<uint8_t> candidates;
+  for (const uint8_t index : available) {
+    if (ApprovedFontIdentities()[index].generic_class == generic_class &&
+        !selected.Contains(index)) {
+      candidates.push_back(index);
+    }
+  }
+  if (candidates.empty()) {
+    return;
+  }
+  // Distinct per-class stage tag; classes 0..2 only.
+  const uint64_t class_tag = 0x6f00000000000001ULL + static_cast<uint64_t>(generic_class);
+  selected.push_back(
+      candidates[HashChoice(profile_hash, class_tag, candidates.size())]);
+}
+
+void AppendRotatedDistinct(uint64_t profile_hash,
+                           base::span<const uint8_t> available,
+                           size_t cap,
+                           Vector<uint8_t>& selected) {
+  Vector<uint8_t> remaining;
+  for (const uint8_t index : available) {
+    if (!selected.Contains(index)) {
+      remaining.push_back(index);
+    }
+  }
+  if (remaining.empty()) {
+    return;
+  }
+  // Hash-rotate the starting position, then take candidates in order so the
+  // selection stays deterministic and distinct.
+  const size_t offset =
+      HashChoice(profile_hash, 0x6f00000000000009ULL, remaining.size());
+  for (size_t i = 0; i < remaining.size() && selected.size() < cap; ++i) {
+    selected.push_back(remaining[(offset + i) % remaining.size()]);
+  }
+}
+
+}  // namespace
+
+base::span<const FontIdentity> ApprovedFontIdentities() {
+  return base::span(kApprovedFontIdentities);
+}
+
+Vector<uint8_t> SelectFontCohort(uint64_t profile_hash,
+                                 base::span<const uint8_t> available) {
+  if (!IsSortedUniqueAndInRange(available, ApprovedFontIdentities().size())) {
+    return {};
+  }
+  Vector<uint8_t> selected;
+  SelectOneAvailableClass(profile_hash, FontGenericClass::kSans, available,
+                          selected);
+  SelectOneAvailableClass(profile_hash, FontGenericClass::kSerif, available,
+                          selected);
+  SelectOneAvailableClass(profile_hash, FontGenericClass::kMonospace,
+                          available, selected);
+  AppendRotatedDistinct(profile_hash, available, 8u, selected);
+  return selected;
+}
+
+std::unique_ptr<FontCohortResolver> FontCohortResolver::Create(
+    uint64_t profile_hash,
+    base::span<const uint8_t> available) {
+  Vector<uint8_t> selected = SelectFontCohort(profile_hash, available);
+  if (selected.empty()) {
+    return nullptr;
+  }
+  auto resolver = std::make_unique<FontCohortResolver>();
+  resolver->selected_ = std::move(selected);
+  return resolver;
+}
+
+bool FontCohortResolver::Allows(const String& name) const {
+  if (name.empty()) {
+    return false;
+  }
+  for (const uint8_t index : selected_) {
+    const FontIdentity& identity = ApprovedFontIdentities()[index];
+    if (EqualIgnoringAsciiCase(identity.primary, name)) {
+      return true;
+    }
+    for (const char* alias : identity.aliases) {
+      if (alias[0] != '\0' && EqualIgnoringAsciiCase(alias, name)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+AtomicString FontCohortResolver::Resolve(FontGenericClass generic_class,
+                                         const AtomicString& requested) const {
+  if (Allows(requested)) {
+    return requested;
+  }
+  Vector<uint8_t> candidates;
+  for (const uint8_t index : selected_) {
+    if (ApprovedFontIdentities()[index].generic_class == generic_class) {
+      candidates.push_back(index);
+    }
+  }
+  if (candidates.empty()) {
+    return AtomicString();
+  }
+  return AtomicString(ApprovedFontIdentities()[candidates.front()].primary);
+}
+
+ScopedFontCohortAvailabilityForTesting::ScopedFontCohortAvailabilityForTesting(
+    Probe probe)
+    : previous_probe_(std::move(AvailabilityProbe())) {
+  AvailabilityProbe() = std::move(probe);
+}
+
+ScopedFontCohortAvailabilityForTesting::
+    ~ScopedFontCohortAvailabilityForTesting() {
+  AvailabilityProbe() = std::move(previous_probe_);
+}
+
+std::unique_ptr<FontCohortResolver> GetFontCohortResolver(
+    ExecutionContext* execution_context) {
+  if (!execution_context ||
+      !base::FeatureList::IsEnabled(blink::features::kHeliumNoise) ||
+      !base::FeatureList::IsEnabled(blink::features::kHeliumNoiseFonts)) {
+    return nullptr;
+  }
+  auto* profile = HeliumNoiseProfile::From(execution_context);
+  if (!profile) {
+    return nullptr;
+  }
+  Vector<uint8_t> available =
+      AvailabilityProbe().is_null() ? Vector<uint8_t>()
+                                    : AvailabilityProbe().Run();
+  return FontCohortResolver::Create(
+      profile->Hash(ProfileDomain::kFont), available);
+}
+
+FontGenericClass ToFontGenericClass(
+    FontDescription::GenericFamilyType generic_family) {
+  switch (generic_family) {
+    case FontDescription::kSerifFamily:
+      return FontGenericClass::kSerif;
+    case FontDescription::kMonospaceFamily:
+      return FontGenericClass::kMonospace;
+    case FontDescription::kNoFamily:
+    case FontDescription::kStandardFamily:
+    case FontDescription::kWebkitBodyFamily:
+    case FontDescription::kSansSerifFamily:
+    case FontDescription::kCursiveFamily:
+    case FontDescription::kFantasyFamily:
+    default:
+      return FontGenericClass::kSans;
+  }
+}
+
+}  // namespace helium_noise
+}  // namespace blink
