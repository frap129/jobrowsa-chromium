+#include "third_party/blink/renderer/core/css/font_face_set_document.h"
+
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/helium_noise/noise_token.h"
+#include "third_party/blink/renderer/core/css/css_font_selector.h"
+#include "third_party/blink/renderer/core/css/style_engine.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/frame/local_frame_view.h"
+#include "third_party/blink/renderer/core/helium_noise/font_cohort.h"
+#include "third_party/blink/renderer/core/testing/page_test_base.h"
+#include "third_party/blink/renderer/platform/fonts/font_description.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace blink {
+
+namespace {
+
+class FontFaceSetTest : public PageTestBase {
+ protected:
+  void SetUp() override { PageTestBase::SetUp(gfx::Size()); }
+
+  void SetHighEntropyToken() {
+    GetPage().SetHeliumNoiseTokens(
+        {{HeliumNoiseFeature::kHighEntropy, HeliumNoiseToken(17)}});
+  }
+};
+
+}  // namespace
+
+TEST_F(FontFaceSetTest, NonCohortLocalSourceIsUnavailable) {
+  helium_noise::ScopedFontCohortAvailabilityForTesting scoped_availability(
+      base::BindRepeating([]() -> Vector<uint8_t> { return {0, 1, 2}; }));
+  SetHighEntropyToken();
+
+  FontSelector* font_selector =
+      GetDocument().GetStyleEngine().GetFontSelector();
+  ASSERT_TRUE(font_selector);
+  const FontDescription description;
+  // The platform-family-availability query FontFaceSet::check/load uses must
+  // consult the same cohort: unapproved names read as unavailable even if
+  // the host installed them.
+  EXPECT_FALSE(font_selector->IsPlatformFamilyMatchAvailable(
+      description, FontFamily(AtomicString("Fingerprint Test Font"),
+                           FontFamily::Type::kFamilyName)));
+  // An approved alias of an installed identity stays available.
+  EXPECT_TRUE(font_selector->IsPlatformFamilyMatchAvailable(
+      description, FontFamily(AtomicString("Arial"), FontFamily::Type::kFamilyName)));
+}
+
+}  // namespace blink
