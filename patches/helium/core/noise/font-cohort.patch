+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_FONT_COHORT_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_FONT_COHORT_H_
+
+#include <array>
+#include <cstdint>
+#include <memory>
+
+#include "base/containers/span.h"
+#include "base/functional/callback.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/fonts/font_description.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+
+namespace blink {
+
+class ExecutionContext;
+class FontDescription;
+
+namespace helium_noise {
+
+enum class FontGenericClass { kSans, kSerif, kMonospace };
+
+// One approved font identity: a primary family name plus up to two
+// ASCII-declared aliases. The table is a fixed compile-time constant;
+// aliases never add a row.
+struct FontIdentity {
+  const char* primary;
+  std::array<const char*, 2> aliases;
+  FontGenericClass generic_class;
+};
+
+// The fixed approved table: 9 identities covering 15 names total.
+CORE_EXPORT base::span<const FontIdentity> ApprovedFontIdentities();
+
+// Selects the cohort of installed font identities visible for this profile.
+// |available| must be a sorted list of unique indices into
+// ApprovedFontIdentities(); anything else fails open to an empty selection.
+// At most 8 identities are selected, covering every generic class at least
+// once among the available rows.
+CORE_EXPORT Vector<uint8_t> SelectFontCohort(uint64_t profile_hash,
+                                             base::span<const uint8_t> available);
+
+// Resolves family names against one selected cohort.
+class CORE_EXPORT FontCohortResolver {
+ public:
+  // Returns nullptr when the selection is empty (fail open).
+  static std::unique_ptr<FontCohortResolver> Create(
+      uint64_t profile_hash,
+      base::span<const uint8_t> available);
+
+  // ASCII case-insensitive match against the selected identities.
+  bool Allows(const String& name) const;
+
+  // Returns |requested| when allowed, otherwise the representative primary
+  // name of the hash-selected available identity of |generic_class|.
+  // An empty result signals the caller to fail open.
+  AtomicString Resolve(FontGenericClass generic_class,
+                       const AtomicString& requested) const;
+
+  FontCohortResolver() = default;
+
+  Vector<uint8_t> selected_;
+};
+
+// Test-only scoped availability seam. Production availability probing is
+// injected by the platform adapter (Task 6); until then the probe returns
+// empty and every seam stays native. Never reachable from renderer input.
+class CORE_EXPORT ScopedFontCohortAvailabilityForTesting {
+ public:
+  using Probe = base::RepeatingCallback<Vector<uint8_t>()>;
+  explicit ScopedFontCohortAvailabilityForTesting(Probe probe);
+  ~ScopedFontCohortAvailabilityForTesting();
+
+ private:
+  Probe previous_probe_;
+};
+
+// One shared seam for every local/system exposure path: master gate ->
+// font gate -> profile probe -> cohort selection. Returns nullptr whenever
+// any gate, the profile, or the validated availability fails so callers
+// follow native behavior.
+CORE_EXPORT std::unique_ptr<FontCohortResolver> GetFontCohortResolver(
+    ExecutionContext*);
+
+// Maps a FontDescription generic family type onto the cohort class;
+// standard/cursive/fantasy and named lookups resolve to sans.
+CORE_EXPORT FontGenericClass ToFontGenericClass(FontDescription::GenericFamilyType generic_family);
+
+}  // namespace helium_noise
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_FONT_COHORT_H_
